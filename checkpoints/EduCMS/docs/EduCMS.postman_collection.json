{
  "info": {
    "name": "EduCMS REST API",
    "description": "Run Sign in first. Development credentials use the SEED_PASSWORD from .env. All writes target your selected baseUrl. Content updates require a current revision.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "email",
      "value": "admin@educms.com"
    },
    {
      "key": "password",
      "value": "ChangeMe123!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "postId",
      "value": "1"
    },
    {
      "key": "revision",
      "value": "1"
    },
    {
      "key": "versionId",
      "value": "1"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "tagId",
      "value": "1"
    },
    {
      "key": "commentId",
      "value": "1"
    },
    {
      "key": "mediaId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "2"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register subscriber",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student\",\n  \"email\": \"student@example.edu\",\n  \"password\": \"ChooseYourPassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Sign out and revoke sessions",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "Change password and revoke sessions",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"{{password}}\",\n  \"password\": \"NewPassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Content",
      "item": [
        {
          "name": "Search and filter",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts?q=React&status=published&content_type=article&page=1&limit=10&sort=newest"
          }
        },
        {
          "name": "Read content",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts/{{postId}}"
          }
        },
        {
          "name": "Read by slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts/slug/getting-started-with-reactjs"
          }
        },
        {
          "name": "Create draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/posts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"A new learning resource\",\n  \"content\": \"<h2>Introduction</h2><p>Learn through practical examples.</p>\",\n  \"excerpt\": \"A practical introduction for curious students.\",\n  \"content_type\": \"article\",\n  \"status\": \"draft\",\n  \"category_id\": 1,\n  \"tag_ids\": [\n    1\n  ],\n  \"meta_title\": \"A new learning resource\",\n  \"meta_description\": \"Learn through practical examples.\",\n  \"meta_keywords\": \"education,tutorial\",\n  \"allow_comments\": true,\n  \"is_featured\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Draft created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const p=pm.response.json().data; pm.collectionVariables.set('postId', p.post_id); pm.collectionVariables.set('revision', p.revision); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Update or publish content",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/posts/{{postId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"A new learning resource\",\n  \"content\": \"<h2>Introduction</h2><p>Learn through practical examples.</p>\",\n  \"excerpt\": \"A practical introduction for curious students.\",\n  \"content_type\": \"article\",\n  \"status\": \"draft\",\n  \"category_id\": 1,\n  \"tag_ids\": [\n    1\n  ],\n  \"meta_title\": \"A new learning resource\",\n  \"meta_description\": \"Learn through practical examples.\",\n  \"meta_keywords\": \"education,tutorial\",\n  \"allow_comments\": true,\n  \"is_featured\": false,\n  \"revision\": \"{{revision}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('revision', pm.response.json().data.revision);"
                ]
              }
            }
          ]
        },
        {
          "name": "Version history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts/{{postId}}/versions"
          }
        },
        {
          "name": "Restore as draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/posts/{{postId}}/versions/{{versionId}}/restore",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"revision\": \"{{revision}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Record a view",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/posts/{{postId}}/view"
          }
        },
        {
          "name": "Toggle a like",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/posts/{{postId}}/like"
          }
        },
        {
          "name": "Delete content permanently",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/posts/{{postId}}"
          }
        }
      ]
    },
    {
      "name": "Taxonomy",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Learning strategies\",\n  \"description\": \"Resources for effective study.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/categories/{{categoryId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Learning strategies\",\n  \"description\": \"Resources for effective study.\",\n  \"parent_id\": null,\n  \"is_active\": true,\n  \"display_order\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/categories/{{categoryId}}"
          }
        },
        {
          "name": "List tags",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tags"
          }
        },
        {
          "name": "Create tag",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tags",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Study tips\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update tag",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tags/{{tagId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Study strategies\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete tag",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/tags/{{tagId}}"
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "List pending comments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/comments?status=pending&page=1&limit=10"
          }
        },
        {
          "name": "Add comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"post_id\": \"{{postId}}\",\n  \"content\": \"Thank you for sharing this resource.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Edit comment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/comments/{{commentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"My updated question.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Moderate comment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/comments/{{commentId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete comment",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/comments/{{commentId}}"
          }
        }
      ]
    },
    {
      "name": "Media",
      "item": [
        {
          "name": "List media",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/media?page=1&limit=12"
          }
        },
        {
          "name": "Upload image or PDF",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/media",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "alt_text",
                  "type": "text",
                  "value": "Describe the image"
                },
                {
                  "key": "caption",
                  "type": "text",
                  "value": "A teaching resource"
                }
              ]
            }
          }
        },
        {
          "name": "Edit media details",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/media/{{mediaId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alt_text\": \"A helpful learning diagram\",\n  \"caption\": \"Learning in context\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete media",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/media/{{mediaId}}"
          }
        }
      ]
    },
    {
      "name": "People",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users?page=1&limit=10"
          }
        },
        {
          "name": "Read user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newauthor\",\n  \"email\": \"newauthor@example.edu\",\n  \"password\": \"ChooseYourPassword123!\",\n  \"role\": \"author\",\n  \"first_name\": \"New\",\n  \"last_name\": \"Author\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Change user access",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{userId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"author\",\n  \"is_active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update own profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Alex\",\n  \"last_name\": \"Morgan\",\n  \"bio\": \"Learning together.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Insights",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Dashboard analytics",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/analytics"
          }
        },
        {
          "name": "Workspace activity",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/analytics/activity?page=1&limit=20"
          }
        }
      ]
    }
  ]
}
