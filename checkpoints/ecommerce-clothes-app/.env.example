# MongoDB Atlas or local MongoDB. Leave empty to explore the demo.
MONGODB_URI=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required for account features when MongoDB is configured. Never prefix with VITE_.
JWT_SECRET=
PORT=3001
# Match the public origin in production, e.g. https://maison.vercel.app
APP_ORIGIN=http://localhost:5173
# Production orders are disabled until you explicitly enable them.
# Orders use payment on delivery; no online card payment is implemented.
ENABLE_ORDERS=false
