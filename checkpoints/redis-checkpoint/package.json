{
  "name": "gtfs-redis-mongodb-checkpoint",
  "version": "1.0.0",
  "private": true,
  "description": "GTFS trip planning and an application-level Redis/MongoDB benchmark",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node src/generate.js",
    "ingest": "node src/ingest.js",
