    "test": "node --test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "mongodb": "^6.20.0",
    "redis": "^4.7.0"
  }
}
